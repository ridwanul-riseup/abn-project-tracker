# Copy to .env.docker and fill in the passwords before `docker compose up`.
# .env.docker is git-ignored; never commit real passwords.

APP_NAME="AB Project Hub"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
# Leave empty to let the container generate one on first start (kept in the storage volume),
# or set your own with `php artisan key:generate --show`.
APP_KEY=

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (used by the app) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ab_project_hub
DB_USERNAME=ab_hub
DB_PASSWORD=

# --- MySQL container (must match the values above) ---
MYSQL_DATABASE=ab_project_hub
MYSQL_USER=ab_hub
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set to true when the hub is served over HTTPS.
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hub@example.com"
MAIL_FROM_NAME="AB Project Hub"

# --- AB Project Hub ---
# Initial Super Admin, created on the first start. If HUB_ADMIN_PASSWORD is empty a random
# password is generated and printed once in `docker compose logs app`.
HUB_ADMIN_NAME="Hub Administrator"
HUB_ADMIN_EMAIL=admin@example.com
HUB_ADMIN_PASSWORD=

HUB_DOCS_PATH=docs
HUB_DOCS_REPO_URL=
HUB_DOCS_REPO_BRANCH=main
HUB_CSP_ENABLED=true

# Run the full database seed on the first start of the container.
HUB_SEED_ON_FIRST_RUN=true
