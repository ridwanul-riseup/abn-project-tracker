APP_NAME="AB Project Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ab_project_hub
DB_USERNAME=ab_hub
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS only).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hub@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AB Project Hub ---
# Initial Super Admin created by `php artisan db:seed`.
# If HUB_ADMIN_PASSWORD is empty a random password is generated and printed once.
HUB_ADMIN_NAME="Hub Administrator"
HUB_ADMIN_EMAIL=admin@example.com
HUB_ADMIN_PASSWORD=

# Directory (relative to the project root) that holds managed Markdown documents.
HUB_DOCS_PATH=docs

# Optional: web URL of this Git repository, used for "View in repository" / "Git history" links.
# Example: https://github.com/your-org/ab-project-hub
HUB_DOCS_REPO_URL=
HUB_DOCS_REPO_BRANCH=main

# Send a Content-Security-Policy header (recommended in production; breaks `npm run dev` hot reload).
HUB_CSP_ENABLED=false
